<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!--
    Publishing also builds the React site (../frontend) and ships it inside the API's wwwroot, so a
    single deployment serves both the website and /api. Needs Node.js on the build machine.
    Skip with -p:SkipFrontendBuild=true (the Dockerfile builds the frontend in its own stage).
  -->
  <Target Name="BuildFrontend" AfterTargets="Publish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <!-- Install only when missing: never delete a node_modules another process (e.g. the dev server) is using. -->
    <Exec WorkingDirectory="..\frontend" Command="npm ci" Condition="!Exists('..\frontend\node_modules')" />
    <Exec WorkingDirectory="..\frontend" Command="npm run build" />
    <ItemGroup>
      <FrontendFiles Include="..\frontend\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <!-- The idempotent schema/migration script, applied at start-up when Database:AutoMigrate is on -->
    <EmbeddedResource Include="..\database\schema.sql" LogicalName="schema.sql" />
  </ItemGroup>

</Project>
